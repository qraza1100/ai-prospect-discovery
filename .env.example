# Copy to .env and fill in the keys you have. Never commit .env.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=INFO

# Web search (Google results). serper | brave
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=

# YouTube Data API v3 (optional; without it YouTube falls back to web search)
YOUTUBE_API_KEY=

# LLM for query understanding and relevance checks. anthropic | gemini | openai | none
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-6-luna
LLM_EFFORT=low
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Discovery limits
SEARCH_RESULTS_PER_QUERY=10
MAX_PROSPECTS=25
ENABLE_WEBSITE_ENRICHMENT=true
MAX_WEBSITES_PER_REQUEST=8
ENABLE_CROSS_PLATFORM_LOOKUP=true
ENRICHMENT_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=90

# Caching (seconds)
CACHE_TTL_SECONDS=900
INTENT_CACHE_TTL_SECONDS=86400

# Protection for public deployments
RATE_LIMIT_PER_MINUTE=10
API_AUTH_TOKEN=
CORS_ALLOW_ORIGINS=[]
